# ==============================================================================
# NEBULA — Autonomous Space Anomaly Investigator
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Credentials & Bedrock Configuration (Generative Reasoning & Reports)
# ------------------------------------------------------------------------------
# In AWS environments (ECS / App Runner / EC2), IAM instance profiles or task roles
# are used automatically via the standard AWS credential provider chain.
# For local development with AWS Bedrock access, specify credentials or configure `aws configure`:
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-optional-session-token

# Amazon Bedrock Foundation Model ID for generative hypothesis formation and final report
# Recommended: Claude 3.5 Sonnet v2, Nova Pro, or Claude 3 Haiku
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# ------------------------------------------------------------------------------
# 2. Strands Decider 2B Configuration (Discrete System-One Tool Selection)
# ------------------------------------------------------------------------------
# URL for the Strands Decider 2B inference endpoint.
# When running locally with decider serving (e.g., via strands-decider serve or vLLM):
STRANDS_DECIDER_URL=http://localhost:8080/v1/system-one

# Decider request timeout in seconds (fast sub-second SLA)
STRANDS_DECIDER_TIMEOUT=1.5

# Calibrated minimum confidence threshold [0.0 - 1.0].
# Decider outputs below this threshold trigger safe scientific triage.
DECIDER_CONFIDENCE_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 3. Investigation Safety & Loop Ceiling
# ------------------------------------------------------------------------------
# Maximum sequential investigation steps per query to guarantee finite execution
MAX_INVESTIGATION_STEPS=4

# ------------------------------------------------------------------------------
# 4. Backend Service Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
# Base URL for the FastAPI backend service
NEXT_PUBLIC_API_URL=http://localhost:8000
